{
    "functions": {
        "source": ".output/server"
    },
    "hosting": {
        "site": "astro-hankey-staging",
        "public": ".output/public",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "cleanUrls": true,
        "rewrites": [
            {
                "source": "**",
                "function": {
                    "functionId": "server",
                    "region": "us-central1",
                    "pinTag": true
                }
            }
        ]
    }
}
