{
    "firestore": {
        "rules": "firestore.rules"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "functions": [
        {
            "source": ".output/server",
            "codebase": "default"
        },
        {
            "source": "functions",
            "codebase": "images",
            "runtime": "nodejs22"
        }
    ],
    "hosting": {
        "site": "astro-hankey",
        "public": ".output/public",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "cleanUrls": true,
        "rewrites": [
            {
                "source": "**",
                "function": {
                    "functionId": "server",
                    "region": "us-central1",
                    "pinTag": true
                }
            }
        ]
    }
}
